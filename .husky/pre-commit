#!/usr/bin/env sh
# Truing pre-commit hook.
#
# Three independent secret scans, all run via docker so no host tool install
# is required. Pinned versions for reproducibility — bump periodically.
#
# Requires: docker daemon reachable from this shell.
#
#   1. Gitleaks staged scan  — primary guard, blocks secrets pre-commit
#   2. Gitleaks history scan — catches anything that snuck in pre-hook
#   3. TruffleHog history    — independent verification

GITLEAKS_IMAGE="zricethezav/gitleaks:v8.30.1"
TRUFFLEHOG_IMAGE="trufflesecurity/trufflehog:3.94.3"
REPO_ROOT=$(git rev-parse --show-toplevel)

# ── Stage scan ────────────────────────────────────────────────────────────────
echo "🔍 Gitleaks: scanning staged changes..."
docker run --rm \
  -v "${REPO_ROOT}/.git:/repo/.git:ro" \
  "${GITLEAKS_IMAGE}" \
  protect --source=/repo --staged --verbose

if [ $? -ne 0 ]; then
  echo "❌ Gitleaks found secrets in staged files. Commit aborted."
  echo "   Fix the file, then: git add <file> && git commit"
  exit 1
fi
echo "✅ Staged files clean."

# ── History scan ──────────────────────────────────────────────────────────────
echo "🔍 Gitleaks: scanning commit history..."
docker run --rm \
  -v "${REPO_ROOT}/.git:/repo/.git:ro" \
  "${GITLEAKS_IMAGE}" \
  detect --source=/repo --no-git=false --verbose

if [ $? -ne 0 ]; then
  echo "❌ Gitleaks found secrets in commit history. Commit aborted."
  echo "   Use git filter-repo or BFG to scrub history."
  exit 1
fi
echo "✅ History clean."

# ── TruffleHog ────────────────────────────────────────────────────────────────
# --fail makes trufflehog exit 183 when secrets are found.
# Without --fail it always exits 0, even on findings.
echo "🐷 Running TruffleHog secret scan..."
docker run --rm \
  -v "${REPO_ROOT}/.git:/repo/.git:ro" \
  "${TRUFFLEHOG_IMAGE}" \
  git file:///repo --fail

TRUFFLEHOG_RC=$?
if [ "${TRUFFLEHOG_RC}" -eq 183 ]; then
  echo "❌ TruffleHog found secrets. Commit aborted."
  exit 1
elif [ "${TRUFFLEHOG_RC}" -ne 0 ]; then
  echo "❌ TruffleHog failed with exit code ${TRUFFLEHOG_RC}. Commit aborted."
  echo "   (Tool failure, not a secret detection. Check docker daemon and image availability.)"
  exit 1
fi
echo "✅ TruffleHog clean. Proceeding with commit."
exit 0
